    {
      "cell_type": "markdown",
      "source": [
        "## Plots 2x2 com os Kernels"
      ],
      "metadata": {
        "id": "_8Vgt5-FKz8k"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "fig, axes = plt.subplots(2, 2, figsize=(12, 8))\n",
        "axes = axes.ravel()\n",
        "\n",
        "kernels = [\"linear\", \"sigmoid\", \"poly\", \"rbf\"]\n",
        "\n",
        "for ax, k in zip(axes, kernels):\n",
        "    svm_vis = SVC(kernel=k, C=1)\n",
        "    svm_vis.fit(X_vis_scaled, y_vis)\n",
        "\n",
        "    DecisionBoundaryDisplay.from_estimator(\n",
        "        svm_vis,\n",
        "        X_vis_scaled,\n",
        "        response_method=\"predict\",\n",
        "        alpha=0.8,\n",
        "        cmap=\"Pastel1\",\n",
        "        ax=ax\n",
        "    )\n",
        "\n",
        "    ax.scatter(\n",
        "        X_vis_scaled[:, 0],\n",
        "        X_vis_scaled[:, 1],\n",
        "        c=y_vis,\n",
        "        s=40,\n",
        "        edgecolors=\"k\",\n",
        "        linewidths=0.5,\n",
        "        cmap=\"viridis\"\n",
        "    )\n",
        "\n",
        "    ax.set_title(f\"kernel = {k}\")\n",
        "    ax.set_xticks([])\n",
        "    ax.set_yticks([])\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ],
